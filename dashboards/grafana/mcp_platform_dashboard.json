{
  "title": "MCP Platform Overview",
  "uid": "mcp-platform",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "gauge", "title": "Cache Hit Ratio",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "orange", "value": 0.4 },
          { "color": "green", "value": 0.6 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "mcp_cache_hit_ratio" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Requests per Second (by tool)",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{tool}} ({{status}})",
        "expr": "sum by (tool, status) (rate(mcp_tool_calls_total[1m]))" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Latency p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(mcp_request_duration_seconds_bucket[5m])))" },
        { "refId": "B", "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(mcp_request_duration_seconds_bucket[5m])))" },
        { "refId": "C", "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(mcp_request_duration_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "AST Guardrail Rejections (by reason)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [ { "refId": "A", "legendFormat": "{{reason}}",
        "expr": "sum by (reason) (rate(mcp_sql_guardrail_rejections_total[5m]))" } ]
    }
  ]
}